---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageMeta from "../../../components/PageMeta.astro";
import CitationCard from "../../../components/CitationCard.astro";
import Fa150Nav from "../../../components/Fa150Nav.astro";
import { fa150MenuGroups } from "../../../data/fa150";
---

<BaseLayout title="Menus do Furuno FA-150" description="Árvore de menus e limites de acesso documentados do FA-150." section="FA-150 · Menus">
  <header class="page-header"><p class="eyebrow">Árvore documentada · revisão M</p><h1>Menus e ajustes</h1><p class="lede">Finalidade, acesso e impacto dos grupos de menu confirmados — sem combinações de teclas ou credenciais supostas.</p></header>
  <PageMeta status="verificado" applicability={["FA-150", "revisão M/P1"]} sourceIds={["SRC-FUR-OME-M", "SRC-FUR-IME-P1"]} />
  <Fa150Nav />
  <CitationCard claimId="FA150-MENU-001" />
  <div class="callout callout--danger"><strong>Acesso técnico autorizado</strong><p>O IME-44310-P1, PDF 26–27, exige senha para INITIAL SETTINGS e declara somente que ela é conhecida pelo representante Furuno. O documento fornecido não revela o valor. FOR SERVICE também é restrito. Nenhuma senha será adivinhada, extraída de fonte não oficial ou publicada.</p></div>
  <CitationCard claimId="FA150-ACCESS-002" />

  <section>
    <h2>Árvore por grupo</h2>
    <div class="card-grid">
      {fa150MenuGroups.map((group) => (
        <article class="card technical-card">
          <small>{group.access}</small><h3>{group.name}</h3><p>{group.impact}</p>
          <ul>{group.branches.map((branch) => <li><code>{branch}</code></li>)}</ul>
          <p class="card__footer"><strong>Fonte:</strong> {group.source}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section">
    <h2>Regra antes de alterar</h2>
    <ol><li>Fotografe e transcreva o estado inicial.</li><li>Confirme autorização para identidade, dimensões, posição de antena, portas e canais.</li><li>Altere um parâmetro por vez, teste o efeito e registre.</li><li>Se o resultado não for aprovado, restaure o valor documentado e escale a divergência.</li></ol>
  </section>
</BaseLayout>
