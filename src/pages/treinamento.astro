---
import BaseLayout from "../layouts/BaseLayout.astro";
import { trainingTrails } from "../data/training";
import PageMeta from "../components/PageMeta.astro";
import { withBase } from "../utilities/path";
---

<BaseLayout title="Treinamento" description="Trilhas locais de treinamento AIS." section="Treinamento">
  <header class="page-header">
    <p class="eyebrow">Progresso local · sem servidor</p>
    <h1>Trilhas de formação</h1>
    <p class="lede">Percursos por nível e especialidade. Marque uma aula somente depois de conseguir explicar objetivo, risco, evidência e próximo teste.</p>
  </header>
  <PageMeta status="verificado" applicability={["Formação técnica", "Simulação sem equipamento real"]} sourceIds={["SRC-FUR-OME-M", "SRC-FUR-IME-P1", "SRC-IMO-A1106"]} />
  <p id="training-state" class="training-state" role="status" hidden></p>

  <div class="card-grid training-grid">
    {trainingTrails.map((trail) => (
      <section class="card training-card" id={`trilha-${trail.id}`}>
        <small>{trail.audience}</small>
        <h2>{trail.title}</h2>
        <ul>
          {trail.lessons.map((lesson, index) => (
            <li>
              <div class="training-lesson">
                <span><a href={withBase(lesson.href)}>{lesson.title}</a><small>{lesson.objective}</small></span>
                <label class="training-check">
                  <input type="checkbox" data-progress={`${trail.id}:${index}`} />
                  <span>Revisada</span>
                </label>
              </div>
            </li>
          ))}
        </ul>
        <div class="training-progress">
          <progress data-trail-bar={trail.id} max={trail.lessons.length} value="0"></progress>
          <p data-trail={trail.id} aria-live="polite">0 de {trail.lessons.length} aulas revisadas</p>
        </div>
      </section>
    ))}
  </div>
  <style>
    .training-card h2 { max-width: none; }
    .training-card ul { list-style: none; padding: 0; }
    .training-card li { padding: .6rem 0; border-top: 1px solid var(--line); }
    .training-lesson { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .8rem; align-items: start; }
    .training-lesson small { display: block; margin-top: .2rem; color: var(--muted); text-transform: none; letter-spacing: 0; }
    .training-check { display: flex; gap: .4rem; align-items: center; padding: .25rem; font-size: .8rem; font-weight: 700; }
    .training-check input { width: 1.15rem; height: 1.15rem; }
    .training-progress { margin-top: auto; padding-top: .8rem; border-top: 1px solid var(--line); }
    .training-progress progress { width: 100%; accent-color: var(--cyan); }
    .training-progress p { margin: .35rem 0 0; color: var(--cyan); font-weight: 800; }
    .training-state { padding: .65rem .8rem; border-left: 3px solid var(--amber); background: var(--amber-soft); }
    .training-card:target { outline: 3px solid var(--cyan); outline-offset: 3px; }
    @media (max-width: 420px) {
      .training-lesson { grid-template-columns: 1fr; }
      .training-check { padding-left: 0; }
    }
  </style>
  <script>
    import { isBooleanRecord, readLocalJson, writeLocalJson } from "../utilities/localState";

    const key = "ais-training-v1";
    const stored = readLocalJson(key, {}, isBooleanRecord);
    const state: Record<string, boolean> = stored.value;
    const stateNotice = document.querySelector<HTMLElement>("#training-state");
    if (stored.recovered && stateNotice) {
      stateNotice.hidden = false;
      stateNotice.textContent = "O progresso local estava inválido e foi restaurado com segurança.";
    }
    const boxes = [...document.querySelectorAll<HTMLInputElement>("[data-progress]")];
    const update = () => {
      document.querySelectorAll<HTMLElement>("[data-trail]").forEach((label) => {
        const trail = label.dataset.trail ?? "";
        const trailBoxes = boxes.filter((box) => box.dataset.progress?.startsWith(`${trail}:`));
        const done = trailBoxes.filter((box) => box.checked).length;
        const percent = trailBoxes.length ? Math.round((done / trailBoxes.length) * 100) : 0;
        label.textContent = `${done} de ${trailBoxes.length} aulas revisadas · ${percent}%`;
        const bar = document.querySelector<HTMLProgressElement>(`[data-trail-bar="${trail}"]`);
        if (bar) bar.value = done;
      });
    };
    boxes.forEach((box) => {
      const id = box.dataset.progress ?? "";
      box.checked = Boolean(state[id]);
      box.addEventListener("change", () => {
        state[id] = box.checked;
        if (!writeLocalJson(key, state) && stateNotice) {
          stateNotice.hidden = false;
          stateNotice.textContent = "Não foi possível salvar o progresso neste navegador.";
        }
        update();
      });
    });
    update();
  </script>
</BaseLayout>
