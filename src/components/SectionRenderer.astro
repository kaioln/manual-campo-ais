---
import type { ContentSection } from "../data/types";
import CitationCard from "./CitationCard.astro";

interface Props {
  section: ContentSection;
}

const { section } = Astro.props;
const sectionId = section.heading
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "");
const headingId = `${sectionId}-titulo`;
---

<section class="content-section" id={sectionId} aria-labelledby={headingId}>
  <h2 id={headingId}>{section.heading}</h2>
  {section.warning && <div class="callout callout--warning"><strong>Atenção</strong><p>{section.warning}</p></div>}
  {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
  {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
  {section.steps && <ol class="steps">{section.steps.map((item) => <li>{item}</li>)}</ol>}
  {section.decision && (
    <div class="decision-flow" aria-label="Fluxo de decisão">
      {section.decision.map((item, index) => (
        <div class="decision-flow__step">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <p>{item}</p>
        </div>
      ))}
    </div>
  )}
  {section.claimIds?.map((claimId) => <CitationCard claimId={claimId} />)}
</section>
